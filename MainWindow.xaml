<Window x:Class="Bluzic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:Bluzic.ViewModels"
        mc:Ignorable="d"
        Title="Bluzic — Bluetooth Audio Receiver"
        Height="640" Width="820"
        MinHeight="540" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Resources/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Border with Rounded Corners & Shadow -->
    <Border Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Main Content -->
                <RowDefinition Height="36" />  <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid Grid.Row="0" Background="#1E293B">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="♬" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Bluzic" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text=" • Bluetooth Audio Receiver" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButton}" Content="—" Click="MinimizeButton_Click" ToolTip="Свернуть" />
                    <Button Style="{StaticResource WindowControlButton}" Content="🗖" Click="MaximizeButton_Click" ToolTip="Развернуть" />
                    <Button Style="{StaticResource WindowCloseButton}" Content="✕" Click="CloseButton_Click" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <!-- ================= MAIN CONTENT ================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Active Connection Hero -->
                        <RowDefinition Height="Auto" /> <!-- App Volume Card -->
                        <RowDefinition Height="Auto" /> <!-- Paired Devices Section -->
                        <RowDefinition Height="Auto" /> <!-- Settings Section -->
                    </Grid.RowDefinitions>

                    <!-- 1. ACTIVE CONNECTION HERO CARD -->
                    <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Bluetooth Pulse Icon -->
                            <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" 
                                    Margin="0,0,16,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#334155" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActiveDeviceConnected}" Value="True">
                                                <Setter Property="Background" Value="#10B981" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="📶" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Status & Device Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <!-- Status Dot -->
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActiveDeviceConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ActiveStatusText}" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="Компьютер работает как беспроводная колонка. Звук со смартфона выводится в динамики ПК." 
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Disconnect / Reconnect Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DangerButton}" 
                                        Content="Отключить" 
                                        Command="{Binding DisconnectCommand}"
                                        Visibility="{Binding IsActiveDeviceConnected, Converter={StaticResource BoolToVisConverter}}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource SecondaryButton}" 
                                        Content="⚙ Настройки BT" 
                                        Command="{Binding OpenBluetoothSettingsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. BLUZIC APP VOLUME CARD -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="ГРОМКОСТЬ ПРИЛОЖЕНИЯ BLUZIC" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Регулирует только громкость входящего звука (не меняет общую громкость Windows)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            </StackPanel>

                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource MediaCircleButton}" Width="34" Height="34" Content="{Binding VolumeIcon}" Command="{Binding ToggleMuteCommand}" Margin="0,0,12,0" ToolTip="Вкл / Выкл звук Bluzic" />
                                <Slider Grid.Column="1" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. PAIRED DEVICES SECTION -->
                    <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Сопряжённые Bluetooth устройства" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Выберите смартфон или планшет для приёма звука" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Content="🔄 Обновить список" Command="{Binding RefreshDevicesCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="➕ Добавить устройство" Command="{Binding OpenBluetoothSettingsCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Device Items List -->
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#243248" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Device Icon -->
                                                <TextBlock Grid.Column="0" Text="{Binding DeviceTypeIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                <!-- Device Name & Status -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Button -->
                                                <Button Grid.Column="2" 
                                                        Padding="16,6"
                                                        FontSize="13"
                                                        Content="{Binding ActionText}" 
                                                        Command="{Binding DataContext.ToggleConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State when no devices are found -->
                            <Border Background="#1A2234" CornerRadius="8" Padding="20" Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDevices}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔍 Нет сопряжённых аудио-устройств" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="Включите Bluetooth на телефоне, откройте параметры Windows и выполните сопряжение с ПК." Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextAlignment="Center" Margin="0,0,0,12" />
                                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Content="Открыть параметры Bluetooth Windows" Command="{Binding OpenBluetoothSettingsCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 4. QUICK SETTINGS SECTION -->
                    <Border Grid.Row="3" Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <TextBlock Text="Настройки" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource ModernToggle}" Content="⚡ Автоподключение к последнему устройству" IsChecked="{Binding AutoConnect, Mode=TwoWay}" Margin="0,0,24,10" />
                                <CheckBox Style="{StaticResource ModernToggle}" Content="📌 Сворачивать в системный трей при закрытии" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0,0,24,10" />
                                <CheckBox Style="{StaticResource ModernToggle}" Content="🚀 Запускать вместе с Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,24,10" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>

            <!-- ================= STATUS BAR ================= -->
            <Border Grid.Row="2" Background="#1E293B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="Bluzic v1.0 • Windows 10/11 A2DP Sink" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                </Grid>
            </Border>

            <!-- ================= SYSTEM TRAY ICON ================= -->
            <tb:TaskbarIcon x:Name="MyTaskbarIcon"
                            IconSource="Resources/app.ico"
                            ToolTipText="Bluzic — Bluetooth Audio Receiver"
                            TrayMouseDoubleClick="TaskbarIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1">
                        <MenuItem Header="Открыть Bluzic" Click="TrayOpen_Click" FontWeight="Bold" />
                        <Separator Background="#334155" />
                        <MenuItem Header="Отключить звук" Command="{Binding ToggleMuteCommand}" />
                        <MenuItem Header="Отключить Bluetooth" Command="{Binding DisconnectCommand}" />
                        <Separator Background="#334155" />
                        <MenuItem Header="Выход" Click="TrayExit_Click" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

        </Grid>
    </Border>
</Window>
